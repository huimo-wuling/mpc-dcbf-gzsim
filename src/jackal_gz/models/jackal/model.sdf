<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="jackal">
    <self_collide>false</self_collide>

    <link name="base_link">
      <inertial>
        <pose>0 0 0.092 0 0 0</pose>
        <mass>16.523</mass>
        <inertia>
          <ixx>0.1789</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.2895</iyy><iyz>0</iyz>
          <izz>0.3752</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>0 0 0.092 0 0 0</pose>
        <geometry><box><size>0.420 0.310 0.184</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <pose>0 0 0.092 0 0 0</pose>
        <geometry><mesh><uri>model://jackal/meshes/jackal-base.stl</uri></mesh></geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
          <specular>0.4 0.4 0.4 1.0</specular>
        </material>
      </visual>

      <!-- Velodyne-class 3D lidar (HDL-32E: 32 beams, -30.67deg .. +10.67deg, 10 Hz) mounted at z=0.5 -->
      <sensor name="velodyne" type="gpu_lidar">
        <pose>0 0 0.5 0 0 0</pose>
        <gz_frame_id>velodyne</gz_frame_id>
        <topic>/velodyne_points</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>0</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.53529</min_angle>
              <max_angle>0.18632</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>70.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <link name="front_left_wheel">
      <pose>0.131 0.187795 0.0345 0 0 0</pose>
      <inertial>
        <mass>0.477</mass>
        <inertia><ixx>0.0013</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0024</iyy><iyz>0</iyz><izz>0.0013</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.040</length></cylinder></geometry>
        <surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><mesh><uri>model://jackal/meshes/jackal-wheel.stl</uri></mesh></geometry>
        <material><ambient>0.1 0.1 0.1 1.0</ambient><diffuse>0.1 0.1 0.1 1.0</diffuse></material>
      </visual>
    </link>
    <link name="front_right_wheel">
      <pose>0.131 -0.187795 0.0345 0 0 0</pose>
      <inertial>
        <mass>0.477</mass>
        <inertia><ixx>0.0013</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0024</iyy><iyz>0</iyz><izz>0.0013</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.040</length></cylinder></geometry>
        <surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><mesh><uri>model://jackal/meshes/jackal-wheel.stl</uri></mesh></geometry>
        <material><ambient>0.1 0.1 0.1 1.0</ambient><diffuse>0.1 0.1 0.1 1.0</diffuse></material>
      </visual>
    </link>
    <link name="rear_left_wheel">
      <pose>-0.131 0.187795 0.0345 0 0 0</pose>
      <inertial>
        <mass>0.477</mass>
        <inertia><ixx>0.0013</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0024</iyy><iyz>0</iyz><izz>0.0013</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.040</length></cylinder></geometry>
        <surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><mesh><uri>model://jackal/meshes/jackal-wheel.stl</uri></mesh></geometry>
        <material><ambient>0.1 0.1 0.1 1.0</ambient><diffuse>0.1 0.1 0.1 1.0</diffuse></material>
      </visual>
    </link>
    <link name="rear_right_wheel">
      <pose>-0.131 -0.187795 0.0345 0 0 0</pose>
      <inertial>
        <mass>0.477</mass>
        <inertia><ixx>0.0013</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0024</iyy><iyz>0</iyz><izz>0.0013</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.098</radius><length>0.040</length></cylinder></geometry>
        <surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5707 0 0</pose>
        <geometry><mesh><uri>model://jackal/meshes/jackal-wheel.stl</uri></mesh></geometry>
        <material><ambient>0.1 0.1 0.1 1.0</ambient><diffuse>0.1 0.1 0.1 1.0</diffuse></material>
      </visual>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <pose relative_to="base_link">0.131 0.187795 0.0345 0 0 0</pose>
      <parent>base_link</parent><child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <pose relative_to="base_link">0.131 -0.187795 0.0345 0 0 0</pose>
      <parent>base_link</parent><child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <pose relative_to="base_link">-0.131 0.187795 0.0345 0 0 0</pose>
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <pose relative_to="base_link">-0.131 -0.187795 0.0345 0 0 0</pose>
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- Velocity limits and odometry taken from jackal_control/config/control.yaml -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <topic>/cmd_vel</topic>
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.37559</wheel_separation>
      <wheel_radius>0.098</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/model/jackal/odometry</odom_topic>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <min_linear_velocity>-2.0</min_linear_velocity>
      <max_linear_velocity>2.0</max_linear_velocity>
      <min_angular_velocity>-4.0</min_angular_velocity>
      <max_angular_velocity>4.0</max_angular_velocity>
      <min_linear_acceleration>-20.0</min_linear_acceleration>
      <max_linear_acceleration>20.0</max_linear_acceleration>
      <min_angular_acceleration>-25.0</min_angular_acceleration>
      <max_angular_acceleration>25.0</max_angular_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>/world/mpc_dcbf/joint_state</topic>
    </plugin>
  </model>
</sdf>
