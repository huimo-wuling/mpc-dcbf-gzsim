Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: GlobalPath
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_path
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: LocalPath
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_path
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: LocalPathVis
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pub_path_vis
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: PredictedObstacles
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /obs_predict_vis_pub
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: ObservedObstacles
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_map_pub/ellipse_vis
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: LidarPoints
      Size (m): 0.03
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /velodyne_points
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: LocalPoints
      Size (m): 0.05
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_map_pub/local_pcd
      Value: true
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Value: true
Window Geometry:
  Height: 900
  Width: 1400
