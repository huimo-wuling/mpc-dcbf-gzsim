  <version>0.1.0</version>
  <description>Bringup for the MPC-D-CBF simulation on ROS 2 + Gazebo Sim (port of scene launch files)</description>
  <maintainer email="huimo-wuling@users.noreply.github.com">huimo-wuling</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>jackal_gz</exec_depend>
